# ===== Cadastro de Motores — variáveis de ambiente =====
# Copie este arquivo para ".env" e preencha o que for usar.
# O app FUNCIONA SEM NENHUMA destas chaves (modo manual + salvar local/ZIP).

# Porta do servidor
PORT=3000

# Nome da pasta raiz onde tudo é arquivado
ROOT_FOLDER_NAME=Cadastro de Motores

# --- IA: leitura automática da placa (Google Gemini) ---
# Gere a chave em https://aistudio.google.com/apikey
# Sem a chave, o app pede os dados manualmente.
GEMINI_API_KEY=
# Modelo (padrão: gemini-2.5-flash). Use gemini-2.5-pro para máxima precisão.
GEMINI_MODEL=gemini-2.5-flash

# --- Google Drive (OAuth) ---
# Crie credenciais OAuth 2.0 (tipo "Aplicativo Web") no Google Cloud Console
# e adicione a URI de redirecionamento abaixo. Sem isto, o app salva local + ZIP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Opcional: preencher depois de conectar uma vez (evita reautenticar)
GOOGLE_REFRESH_TOKEN=
# Opcional: ID de uma pasta do Drive onde criar a raiz (vazio = Meu Drive)
GOOGLE_PARENT_FOLDER_ID=

# --- Imagens ---
MAX_IMAGE_DIMENSION=2000
IMAGE_QUALITY=82

# Pasta de armazenamento local (modo fallback)
# STORAGE_DIR=./storage
