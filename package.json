  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.0.0",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5"
  }
