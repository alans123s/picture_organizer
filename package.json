{
  "name": "cadastro-motores",
  "version": "1.0.0",
  "description": "Assistente de cadastro de motores elétricos em campo, com leitura da placa por IA (Gemini) e arquivamento padronizado no Google Drive.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
